# Copy this file to .env.local and fill in your Sully credentials.
# Leave SULLY_API_KEY empty to run the app in demo mode (no API calls are made).
SULLY_ACCOUNT_ID=
SULLY_API_KEY=
SULLY_API_BASE_URL=https://api.sully.ai

# Login. SESSION_SECRET signs the session cookie; use a long random string
# (for example: openssl rand -hex 32). If it is empty, a random dev secret is
# created in data/session-secret.
SESSION_SECRET=

# The admin account created on first run. If these are empty the admin is
# admin@example.com with password change-me. Change it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
